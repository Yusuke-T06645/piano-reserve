# このファイルをコピーして .env.local を作成してください（cp .env.example .env.local）。
# 未編集のままでも STORE_BACKEND=local の範囲でそのまま動作します（詳細はREADME参照）。
# 本番運用（Google Sheets連携・実メール送信・Vercelデプロイ）への切り替え手順は
# docs/DEPLOYMENT.md を参照してください。

# --- データストア ---
# local: アプリ内のJSONファイル（var/data/db.json）。すぐ試せるが本番不可（サーバーレス環境では永続化されない）
# sheets: Google Sheetsを台帳として使う本番運用向け実装
STORE_BACKEND=local

# --- 管理者アカウント（local ストアの初回起動時に自動作成される） ---
# 本番公開前に必ず変更すること（docs/DEPLOYMENT.md の「3. 管理者アカウントの設定」参照）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
# ADMIN_PASSWORD の代わりに、bcryptハッシュを直接指定することもできる（本番ではこちらを推奨）
# ADMIN_PASSWORD_HASH=
# 管理者セッションの署名用シークレット（本番では十分に長いランダム文字列に変更すること）
ADMIN_SESSION_SECRET=dev-only-insecure-secret-change-me

# --- 通知先メールアドレス ---
ADMIN_NOTIFY_EMAIL=admin@example.com
SUPPORT_EMAIL=piano-support@example.com

# --- メール送信（Resend） ---
# 未設定の場合、メールは実送信されず var/outbox/ にHTMLファイルとして保存されるのみ（開発確認用）
# RESEND_API_KEY=
# MAIL_FROM="田中組グランドピアノ開放事業 <no-reply@your-domain>"

# --- Google Sheets連携（STORE_BACKEND=sheets の場合のみ必須） ---
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# --- Cron保護（/api/cron/* エンドポイント） ---
# 本番でCron（リマインダー送信・ノーショー判定）を有効にする場合は設定すること
# CRON_SECRET=

# --- サイトURL ---
# QRコードや通知メール内のリンク生成に使われる。本番では実際の公開URLに変更すること
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- ローカルストアのDBファイルパス（省略時は var/data/db.json） ---
# LOCAL_DB_PATH=
